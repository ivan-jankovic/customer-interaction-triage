# Copy to .env (never commit .env). The dataset scripts in eval/ and `npm run classify` call a model.
ANTHROPIC_API_KEY=

# The pipeline's understanding step (npm run classify, npm run process and the queue worker).
# TRIAGE_EFFORT: low, medium, high, xhigh or max.
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=low
# The investigating agent (P10) for technical faults; empty means the same as TRIAGE_MODEL / TRIAGE_EFFORT.
INVESTIGATE_MODEL=
INVESTIGATE_EFFORT=

# The evaluation's summary judge (npm run eval).
EVAL_JUDGE_MODEL=claude-haiku-5-5
EVAL_JUDGE_EFFORT=low

# Models used to build the dataset (defaults shown).
DATASET_GENERATOR_MODEL=claude-opus-5-5
DATASET_GRADER_A_MODEL=claude-sonnet-5-5
DATASET_GRADER_B_MODEL=claude-haiku-5-5

# The queue worker (npm run worker, or `docker compose --profile worker up -d`): jobs run at once.
# It processes every stored interaction that has no case yet, and each one is a paid model call.
WORKER_CONCURRENCY=4

# The review loop (npm run review): your reviewer handle, e.g. reviewer-1 (no real names).
REVIEWER=

# Local services from docker-compose.yml (local development credentials only).
# If you change POSTGRES_PORT or REDIS_PORT for Compose, change the ports here too.
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379

# Intake API (npm run dev, the Compose app service) and the dataset loader (npm run dataset:load).
# INTAKE_API_KEY: at least 32 characters; generate one with `openssl rand -hex 32`.
# Compose reads it from .env too; without it, the app container exits with a message.
INTAKE_API_KEY=
# Port of `npm run dev` (Compose publishes the app on APP_PORT, default 3000).
PORT=3000
API_URL=http://localhost:3000
