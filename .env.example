# Copy to .env (never commit .env). Only the dataset scripts in eval/ call a model.
ANTHROPIC_API_KEY=

# Models used to build the dataset (defaults shown).
DATASET_GENERATOR_MODEL=claude-opus-5-5
DATASET_GRADER_A_MODEL=claude-sonnet-5-5
DATASET_GRADER_B_MODEL=claude-haiku-5-5

# Local services from docker-compose.yml (local development credentials only).
# If you change POSTGRES_PORT or REDIS_PORT for Compose, change the ports here too.
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379

# Intake API (npm run dev, the Compose app service) and the dataset loader (npm run dataset:load).
# INTAKE_API_KEY: at least 32 characters; generate one with `openssl rand -hex 32`.
# Compose reads it from .env too; without it, the app container exits with a message.
INTAKE_API_KEY=
# Port of `npm run dev` (Compose publishes the app on APP_PORT, default 3000).
PORT=3000
API_URL=http://localhost:3000
