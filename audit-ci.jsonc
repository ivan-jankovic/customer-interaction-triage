// Dependency audit: `npm run audit`. Fails on any advisory of any severity (low and up),
// except the allowlist below. Keep the allowlist as narrow as possible: one advisory,
// one dependency path, with a reason and an expiry date, e.g.
//   { "GHSA-xxxx-xxxx-xxxx|vitest>vite>pkg": { "active": true, "notes": "why", "expiry": "YYYY-MM-DD" } }
// History: P00 allowlisted GHSA-fc5q-39xc-vjpf (picomatch, via Vitest); removed in P01 once picomatch 4.0.7 fixed it.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "low": true,
  "allowlist": []
}
