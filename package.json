{
  "name": "customer-interaction-triage",
  "version": "0.0.0",
  "private": true,
  "description": "First-pass triage of customer messages for a fictional Czech internet and mobile provider.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "//": [
    "typescript resolves to the TypeScript 6 API (@typescript/typescript6) because typescript-eslint does not support TS 7.0;",
    "typecheck runs TypeScript 7 (@typescript/native) by path, since both packages ship a tsc binary.",
    "Remove the alias once typescript-eslint supports TS 7.1+ (P01 requirements.md)."
  ],
  "scripts": {
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "audit": "audit-ci --config audit-ci.jsonc",
    "dataset:plan": "tsx eval/dataset/plan.ts",
    "dataset:generate": "tsx --env-file-if-exists=.env eval/dataset/generate.ts",
    "dataset:grade": "tsx --env-file-if-exists=.env eval/dataset/grade.ts",
    "dataset:review": "tsx eval/dataset/review.ts",
    "dataset:finalize": "tsx eval/dataset/finalize.ts",
    "dataset:stats": "tsx eval/dataset/stats.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts latest",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ioredis": "^6.0.0",
    "json-schema-to-ts": "^3.1.1",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "audit-ci": "^7.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
